{
	"name": "blog",
	"version": "1.5.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "node scripts/build.mjs && tailwindcss -i src/styles.css -o public/styles.css --minify",
		"dev": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"start": "npm run dev"
	},
	"devDependencies": {
		"@tailwindcss/cli": "^4.3.3",
		"@tailwindcss/typography": "^0.5.20",
		"gray-matter": "^4.0.3",
		"marked": "^18.1.2",
		"tailwindcss": "^4.3.3",
		"wrangler": "^4.156.0"
	},
	"allowScripts": {
		"wrangler@4.156.0": true,
		"tailwindcss@4.3.3": true,
		"@tailwindcss/cli@4.3.3": true,
		"esbuild@0.28.2": true,
		"workerd@1.20261023.1": true,
		"@parcel/watcher@2.5.1": true
	}
